{
  "name": "openharness",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "pnpm --filter @openharness/server dev",
    "dev:web": "pnpm --filter @openharness/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "check:dates": "node scripts/check-dates.mjs",
    "start": "pnpm --filter @openharness/server start",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
